{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Read",
            "Edit(/**)",
            "Glob",
            "Grep",
            "Skill",
            "mcp__youtrack__*",
            "mcp__laravel-boost__*",
            "Bash(php scripts/yt.php *)",
            "Bash(scripts/run-tests.sh)",
            "Bash(scripts/run-tests.sh *)",
            "Bash(RUN_TESTS_FULL=1 scripts/run-tests.sh)",
            "Bash(RUN_TESTS_FULL=1 scripts/run-tests.sh *)",
            "Bash(scripts/agent-commit.sh *)",
            "Bash(scripts/agent-loop.sh --dry-run*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git branch*)",
            "Bash(git rev-parse *)",
            "Bash(git ls-files*)",
            "Bash(git grep *)",
            "Bash(git blame *)",
            "Bash(git merge-base *)",
            "Bash(git for-each-ref *)",
            "Bash(git worktree list*)",
            "Bash(git restore *)",
            "Bash(git push -u origin epic/*)",
            "Bash(git push origin epic/*)",
            "Bash(gh pr *)",
            "Bash(composer install*)",
            "Bash(composer dump-autoload*)",
            "Bash(composer show*)",
            "Bash(composer test*)",
            "Bash(composer lint*)",
            "Bash(php artisan *)",
            "Bash(php -l *)",
            "Bash(php -v)",
            "Bash(php -i)",
            "Bash(php -m)",
            "Bash(vendor/bin/pint *)",
            "Bash(vendor/bin/phpstan*)",
            "Bash(vendor/bin/rector*)",
            "Bash(vendor/bin/pest*)",
            "Bash(vendor/bin/phpunit*)",
            "Bash(bun install*)",
            "Bash(bun run *)",
            "Bash(npm ci*)",
            "Bash(npm run *)",
            "Bash(ls*)",
            "Bash(cat *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Bash(grep *)",
            "Bash(rg *)",
            "Bash(find *)",
            "Bash(sort *)",
            "Bash(diff *)",
            "Bash(mkdir *)",
            "Bash(touch *)",
            "Bash(pwd)",
            "Bash(hostname)",
            "Bash(date*)",
            "Bash(which *)",
            "Bash(test *)",
            "Bash(cd *)",
            "Bash(sed -n *)",
            "Bash(cut *)",
            "Bash(uniq *)",
            "Bash(tr *)",
            "Bash(echo *)",
            "Bash(basename *)",
            "Bash(dirname *)",
            "Bash(realpath *)",
            "Bash(stat *)",
            "Bash(file *)",
            "Bash(du *)",
            "Bash(tree *)",
            "Bash(git -C . *)",
            "Bash(php scripts/agent-log.php *)",
            "Bash(rm *)",
            "Bash(mv *)",
            "Bash(cp *)",
            "Bash(XDEBUG_MODE=coverage scripts/run-tests.sh *)",
            "Bash(XDEBUG_MODE=coverage vendor/bin/pest *)",
            "Bash(kill -0 *)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push origin {{base_branch}}*)",
            "Bash(git push origin main*)",
            "Bash(git push origin master*)",
            "Bash(git push origin HEAD*)",
            "Bash(git reset --hard*)",
            "Bash(git clean *)",
            "Bash(git rebase *)",
            "Bash(git checkout {{base_branch}}*)",
            "Bash(git checkout main*)",
            "Bash(git worktree remove *)",
            "Bash(composer require *)",
            "Bash(composer remove *)",
            "Bash(composer update*)",
            "Bash(composer bump*)",
            "Bash(bun add *)",
            "Bash(bun remove *)",
            "Bash(bun update*)",
            "Bash(npm install *)",
            "Bash(npm uninstall *)",
            "Bash(npm update*)",
            "Bash(sudo *)",
            "Read(./.env.production)",
            "Read(./.env.staging)",
            "Read(**/.env.production)",
            "Read(**/.env.staging)",
            "Read(~/.claude.json)",
            "Read(~/.ssh/**)",
            "Read(~/.config/gh/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.php",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "enabledMcpjsonServers": [
        "laravel-boost"
    ]
}
