{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alexxosipov/agentio",
    "description": "Autonomous agentic development cycle for Laravel: YouTrack as the source of truth, Claude Code as PM, analyst, architect, developer and reviewer.",
    "keywords": [
        "laravel",
        "agentio",
        "youtrack",
        "claude-code",
        "ai-agents"
    ],
    "homepage": "https://github.com/Alexxosipov/agentio",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexxosipov",
            "email": "alexxosipov@yandex.ru",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Alexxosipov/agentio/issues",
        "source": "https://github.com/Alexxosipov/agentio"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0||^13.0",
        "illuminate/bus": "^12.0||^13.0",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/process": "^12.0||^13.0",
        "illuminate/queue": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0",
        "laravel/prompts": "^0.3",
        "nesbot/carbon": "^3.8.4",
        "saloonphp/saloon": "^4.5",
        "symfony/console": "^7.2||^8.0",
        "symfony/http-foundation": "^7.2||^8.0",
        "symfony/process": "^7.2||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "laravel/horizon": "Works the queue of the Telegram bot (agentio:setup-telegram installs it)",
        "ext-redis": "Redis for Horizon (or predis/predis)",
        "predis/predis": "Redis client when ext-redis is missing",
        "ext-pcntl": "Job timeouts and signal handling of agentio:run and agentio:telegram listen"
    },
    "autoload": {
        "psr-4": {
            "Obrazmisli\\Agentio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obrazmisli\\Agentio\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@clear",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obrazmisli\\Agentio\\AgentioServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
