{
    "$comment": "Permissions of the planning sessions (/agentio-plan), which run in the developer's main checkout: they read the code and work with YouTrack, and change no file. Merged by SessionSettings::planning() with the deny rules of settings.json.",
    "permissions": {
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Skill",
            "WebSearch",
            "WebFetch(domain:core.telegram.org)",
            "WebFetch(domain:docs.telegram-mini-apps.com)",
            "WebFetch(domain:dev.vk.com)",
            "WebFetch(domain:web.dev)",
            "WebFetch(domain:developer.mozilla.org)",
            "WebFetch(domain:docs.saloon.dev)",
            "WebFetch(domain:laravel.com)",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:raw.githubusercontent.com)",
            "mcp__youtrack__*",
            "mcp__laravel-boost__search-docs",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__database-schema",
            "Bash(php artisan agentio:yt *)",
            "Bash(php artisan agentio:log *)",
            "Bash(php artisan agentio:status*)",
            "Bash(php artisan agentio:run --dry-run*)",
            "Bash(php artisan route:list*)",
            "Bash(php artisan about*)",
            "Bash(php artisan list*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git branch*)",
            "Bash(git rev-parse *)",
            "Bash(git ls-files*)",
            "Bash(git grep *)",
            "Bash(git blame *)",
            "Bash(git merge-base *)",
            "Bash(git for-each-ref *)",
            "Bash(git worktree list*)",
            "Bash(ls*)",
            "Bash(cat *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Bash(grep *)",
            "Bash(rg *)",
            "Bash(find *)",
            "Bash(sort *)",
            "Bash(tree *)",
            "Bash(pwd)",
            "Bash(hostname)",
            "Bash(date*)"
        ],
        "deny": [
            "Edit",
            "Write",
            "NotebookEdit",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git merge *)",
            "Bash(git checkout *)",
            "Bash(git switch *)",
            "Bash(git push *)"
        ]
    }
}
