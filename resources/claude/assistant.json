{
    "$comment": "Permissions of the assistant of the Telegram bot (agentio-telegram-assistant), which runs in the developer's main checkout: it reads the code, the state of the loop and YouTrack, and changes nothing — agentio makes the YouTrack changes it decides on (answers, comments, ideas). Merged by SessionSettings::assistant() with the deny rules of settings.json.",
    "permissions": {
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Skill",
            "mcp__youtrack__get_issue",
            "mcp__youtrack__get_issue_comments",
            "mcp__youtrack__search_issues",
            "mcp__youtrack__get_article",
            "mcp__youtrack__search_articles",
            "mcp__youtrack__get_issue_fields_schema",
            "mcp__youtrack__get_project",
            "mcp__youtrack__get_current_user",
            "mcp__laravel-boost__search-docs",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__database-schema",
            "Bash(php artisan agentio:yt ideas*)",
            "Bash(php artisan agentio:yt ready-epics*)",
            "Bash(php artisan agentio:yt claimed-epics*)",
            "Bash(php artisan agentio:yt tree *)",
            "Bash(php artisan agentio:yt ready-tasks *)",
            "Bash(php artisan agentio:yt blocked*)",
            "Bash(php artisan agentio:yt state *)",
            "Bash(php artisan agentio:yt kb-tree*)",
            "Bash(php artisan agentio:status*)",
            "Bash(php artisan agentio:log *)",
            "Bash(php artisan agentio:run --dry-run*)",
            "Bash(git status*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git diff*)",
            "Bash(git branch*)",
            "Bash(git ls-files*)",
            "Bash(ls*)",
            "Bash(cat *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Bash(grep *)",
            "Bash(rg *)",
            "Bash(find *)",
            "Bash(date*)"
        ],
        "deny": [
            "Edit",
            "Write",
            "NotebookEdit",
            "mcp__youtrack__create_issue",
            "mcp__youtrack__update_issue",
            "mcp__youtrack__add_issue_comment",
            "mcp__youtrack__link_issues",
            "mcp__youtrack__manage_issue_tags",
            "mcp__youtrack__create_article",
            "mcp__youtrack__update_article",
            "Bash(php artisan agentio:yt claim*)",
            "Bash(php artisan agentio:yt release*)",
            "Bash(php artisan agentio:telegram*)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git merge *)",
            "Bash(git checkout *)",
            "Bash(git switch *)",
            "Bash(git push *)"
        ]
    }
}
